{
  "name": "nether-council",
  "private": true,
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=24 <26"
  },
  "scripts": {
    "dev": "pnpm --filter @nether/web dev",
    "dev:voice": "vercel dev --listen 3000",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "build": "pnpm --filter @nether/web build",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "test:e2e": "playwright test",
    "smoke": "tsx scripts/smoke.ts",
    "probe:providers": "tsx scripts/probe-providers.ts"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.1",
    "eslint": "9.39.1",
    "eslint-config-next": "16.4.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vercel": "65.8.0",
    "vitest": "5.0.5",
    "ws": "8.18.3",
    "@types/ws": "8.18.1"
  },
  "type": "module"
}
