{
  "name": "nether-council",
  "private": true,
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=24 <26"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:voice": "vercel dev --listen 3000",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "build": "pnpm --filter @nether/web build",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm assets:verify && pnpm build",
    "test:e2e": "playwright test",
    "test:load": "tsx scripts/load-test.ts",
    "smoke": "tsx scripts/smoke.ts",
    "probe:providers": "tsx scripts/probe-providers.ts",
    "probe:relay": "tsx scripts/probe-relay.ts",
    "verify:real": "tsx scripts/verify-real-encounter.ts",
    "env:vercel": "tsx scripts/configure-vercel.ts",
    "telemetry:collect": "tsx scripts/collect-telemetry.ts",
    "report:pilot": "tsx scripts/report-pilot.ts",
    "invite:create": "tsx scripts/create-invite.ts",
    "assets:verify": "tsx scripts/verify-assets.ts",
    "assets:prepare:meng-po": "tsx scripts/prepare-meng-po.ts",
    "dev:gateway": "tsx scripts/dev-gateway.ts",
    "verify:voice-gateway": "tsx scripts/verify-voice-gateway.ts",
    "test:voice": "uv run --project services/voice --frozen pytest services/voice/tests -q",
    "test:e2e:realtime": "playwright test --config playwright.realtime.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@gltf-transform/cli": "4.5.1",
    "@nether/contracts": "workspace:*",
    "@nether/party-core": "workspace:*",
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.1",
    "@types/ws": "8.18.1",
    "esbuild": "0.27.7",
    "eslint": "9.39.1",
    "eslint-config-next": "16.4.3",
    "jsqr": "1.4.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vercel": "65.8.0",
    "vitest": "5.0.5",
    "ws": "8.18.3"
  },
  "type": "module"
}
